{
  manifest_version: "0.1.0",
  slots: {
    proxy: { kind: "a2a", optional: true },
  },
  program: {
    image: "tenalirama2026/cybergym-agentx@sha256:bc6667820a548185fbb40093fa636286cd282c099d5c51d114445a8ac832108a",
    entrypoint: "/app/cybergym_agentx",
    env: {
      AZURE_OPENAI_KEY: "${config.openai_api_key}",
      AZURE_OPENAI_ENDPOINT: "https://pi-bench-agentx-resource.cognitiveservices.azure.com/",
      PORT: "9009",
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
}
